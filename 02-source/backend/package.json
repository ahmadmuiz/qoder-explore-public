{
  "name": "@laras/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Laras payment reconciliation API for Bank Cakrawala Nusantara vendor invoice operations",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:treasury": "tsx scripts/seed-treasury.ts",
    "recon:treasury": "tsx scripts/recon-treasury.ts",
    "reset": "rm -f data/recon.db data/recon.db-shm data/recon.db-wal && npm run seed",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "showcase:treasury": "tsx scripts/showcase-treasury.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "csv-parse": "^5.6.0",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
